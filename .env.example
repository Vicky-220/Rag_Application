# ================================================================
# Local MultiAgentic RAG System - Configuration
# ================================================================

# ----------------------------------------------------------------
# LLM Configuration (OpenAI-compatible by default)
# Works with: llama-server (llama.cpp), Ollama (/v1), vLLM, LM Studio, Cloud (OpenAI, Groq, OpenRouter)
# ----------------------------------------------------------------
LLM_PROVIDER=openai
# For llama.cpp (llama-server running on default port 8080):
LLM_BASE_URL=http://localhost:8080/v1
# For Ollama (OpenAI-compatible endpoint):
# LLM_BASE_URL=http://localhost:11434/v1
# For Cloud OpenAI:
# LLM_BASE_URL=https://api.openai.com/v1

LLM_API_KEY=not-needed
# For Cloud models, set your real API key:
# LLM_API_KEY=sk-...

LLM_MODEL=qwen3.5-4b
# For Ollama e.g.: qwen2.5:3b or llama3.2:3b
# For Cloud e.g.: gpt-4o-mini

LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# ----------------------------------------------------------------
# Embedding Configuration
# Options for EMBEDDING_PROVIDER:
#   1. "local"  : Fast embedded ONNX all-MiniLM-L6-v2 (Zero external server needed)
#   2. "openai" : OpenAI-compatible /v1/embeddings (llama-server with --embeddings, Ollama, OpenAI)
#   3. "ollama" : Native Ollama embeddings API
# ----------------------------------------------------------------
EMBEDDING_PROVIDER=local
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=not-needed
EMBEDDING_MODEL=all-MiniLM-L6-v2
# For Ollama embedding models: bge-m3:latest, nomic-embed-text, etc.
# For OpenAI: text-embedding-3-small

# ----------------------------------------------------------------
# RAG Retrieval Configuration
# ----------------------------------------------------------------
SIMILARITY_THRESHOLD=0.3
TOP_K_CHUNKS=5
CONTEXT_TURNS=3

# ----------------------------------------------------------------
# Server Configuration
# ----------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false
